# Writes OUTPUT: a C++ file holding every file matching the glob PATTERNS
# (relative to ASSET_ROOT), keyed by their path relative to ASSET_ROOT. The
# files are concatenated and gzipped next to OUTPUT (content.gz), which the
# C++ file pulls in with #embed: compressed, the module stays under
# Maincloud's upload limit. Run in script mode:
#   cmake -DASSET_ROOT=... -DPATTERNS=play/tuning/*.json;play/clubs/*.json -DOUTPUT=... -P embed_content.cmake

get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
set(bundle "${output_dir}/content.bin")
set(compressed "${output_dir}/content.gz")
set(entries "")
set(parts "")
set(batch "")
set(offset 0)
set(count 0)
# Byte for byte: cmake -E cat joins the files, file(SIZE) gives their lengths.
# Batches keep each command line short.
macro(flush_batch)
    if (batch)
        list(LENGTH parts part_count)
        set(part "${output_dir}/content_part_${part_count}.bin")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E cat ${batch} OUTPUT_FILE "${part}" RESULT_VARIABLE failed)
        if (failed)
            message(FATAL_ERROR "could not join the content files")
        endif()
        list(APPEND parts "${part}")
        set(batch "")
    endif()
endmacro()
foreach(pattern IN LISTS PATTERNS)
    file(GLOB_RECURSE files LIST_DIRECTORIES false "${ASSET_ROOT}/${pattern}")
    list(SORT files)
    foreach(path IN LISTS files)
        file(RELATIVE_PATH relative "${ASSET_ROOT}" "${path}")
        file(SIZE "${path}" size)
        list(APPEND batch "${path}")
        string(APPEND entries "    {\"${relative}\", ${offset}, ${size}},\n")
        math(EXPR offset "${offset} + ${size}")
        math(EXPR count "${count} + 1")
        list(LENGTH batch batch_size)
        if (batch_size EQUAL 50)
            flush_batch()
        endif()
    endforeach()
endforeach()
flush_batch()
execute_process(COMMAND "${CMAKE_COMMAND}" -E cat ${parts} OUTPUT_FILE "${bundle}" RESULT_VARIABLE failed)
if (failed)
    message(FATAL_ERROR "could not join the content files")
endif()
file(SIZE "${bundle}" bundle_size)
if (NOT bundle_size EQUAL offset)
    message(FATAL_ERROR "the joined content is ${bundle_size} bytes, not ${offset}")
endif()
file(REMOVE "${compressed}" ${parts})
file(ARCHIVE_CREATE OUTPUT "${compressed}" PATHS "${bundle}" FORMAT raw COMPRESSION GZip COMPRESSION_LEVEL 9)
file(REMOVE "${bundle}")

set(source "// Generated by server/golfpp_module/embed_content.cmake. Do not edit.\n\n")
string(APPEND source "#include \"embedded_content.h\"\n\n")
string(APPEND source "#pragma clang diagnostic ignored \"-Wc23-extensions\"\n")
string(APPEND source "const unsigned char embedded_gzip[] = {\n#embed \"${compressed}\"\n};\n")
string(APPEND source "const std::size_t embedded_gzip_size = sizeof(embedded_gzip);\n")
string(APPEND source "const std::size_t embedded_content_size = ${offset};\n\n")
string(APPEND source "const embedded_file embedded_files[] = {\n${entries}};\n")
string(APPEND source "const std::size_t embedded_file_count = ${count};\n")

# The .cpp only changes when the index does, but #embed's file always may.
if (EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if (previous STREQUAL source)
        file(TOUCH "${OUTPUT}")
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${source}")
